    },
    "DragonHornet": {
      "DisplayName": "龙黄蜂",
      "Bestiary": "普通黄蜂的近亲，这些昆虫进化出奇特的外表来吓退敌人。如果这还不够，毒刺应该能完成任务。"
    },
    "DragonSkull": {
      "DisplayName": "龙头骨",
      "Bestiary": "受到死灵法术的影响，古代爬行动物的头颅现在猎杀活物，并将诅咒传给它们的受害者。"
    },
    "DragonSnatcher": {
      "DisplayName": "龙抢夺者",
      "Bestiary": "这种抢夺者学会了利用捕获的黄蜂的毒刺来猎杀更大的目标。"
    },
    "FleshAxe": {
      "DisplayName": "血肉斧",
      "Bestiary": "被猩红集体施法，这把武器自行移动并砍杀敌人。"
    },
    "FleshMummy": {
      "DisplayName": "血肉木乃伊",
      "Bestiary": "由于外力改变了沙漠中的沙土，那些被安葬在沙漠中的人，无论善恶，现在都站起来伤人杀人。"
    },
    "FleshSlime": {
      "DisplayName": "血肉史莱姆",
      "Bestiary": "浸润在猩红之力中，这些史莱姆能够传播它们的排泄物。"
    },
    "GiantAlbinoCharger": {
      "DisplayName": "巨型白化冲锋兽",
      "Bestiary": "少数蚁狮士兵会发生突变，失去体色，变得比它们的虫群兄弟们更加凶猛。"
    },
    "ShadowHammer": {
      "DisplayName": "暗影锤",
      "Bestiary": "被腐化之地的纯粹仇恨施加了魔法，这把武器四处挥舞，试图粉碎任何会呼吸的东西。"
    },
    "ShadowMummy": {
      "DisplayName": "暗影木乃伊",
      "Bestiary": "由于外力改变了沙漠中的沙土，那些被安葬在沙漠中的人，无论善恶，现在都站起来伤人杀人。"
    },
    "ShadowSlime": {
      "DisplayName": "暗影史莱姆",
      "Bestiary": "浸润在腐化之力中，这些史莱姆能够传播它们的排泄物。"
    },
    "SpectralElemental": {
      "DisplayName": "幽灵元素",
      "Bestiary": "有时被释放的光之灵会将混沌元素转化为更强大的存在，使它们能够随意进出物质位面，同时放置爆炸性的幽灵符文。"
    },
    "SpectralMummy": {
      "DisplayName": "幽灵木乃伊",
      "Bestiary": "这些木乃伊身上溢出的光能使它们破烂不堪的身体变得极度不稳定。"
    },
    "VampireMiner": {
      "DisplayName": "吸血鬼矿工",
      "Bestiary": "有证据表明，一些洞穴探险者在去世前被吸血蝙蝠咬过……现在他们腐烂的遗骸出来寻找鲜血。"
    },
    "BigEgg": {
      "DisplayName": "天兔 蛋"
    },
    "SmallEgg": {
      "DisplayName": "天兔 蛋"
    },
    "ChocolateEgg": {
      "DisplayName": "巧克力蛋"
    },
    "DisasterBunny": {
      "DisplayName": "灾难兔兔",
      "Bestiary": "狂暴巨兔的灾难性后代，这些大眼睛生物会咬任何它们遇到的东西。"
    },
    "Lepus": {
      "DisplayName": "天兔",
      "Bestiary": "仿佛它的体型还不够麻烦，这只兔子可以通过彩色蛋繁殖，在春天散布在世界各地，供傻瓜们捡拾。"
    },
    "Ocram": {
      "DisplayName": "奥库瑞姆",
      "Bestiary": "这个被遗忘的堕落恶魔，曾经的暗黑帝王，现在寻求对所有地表居民的复仇。"
    },
    "ServantofOcram": {
      "DisplayName": "奥库瑞姆仆从",
      "Bestiary": "由奥库瑞姆具现化出的邪恶生物，被召唤出来以不惜一切代价保护它们的主人。"
    },
    "TurkorNeck": {
      "DisplayName": "不感恩的火鸡"
    },
    "TurkortheUngrateful": {
      "DisplayName": "不感恩的火鸡"
    },
    "TurkortheUngratefulHead": {
      "DisplayName": "不感恩的火鸡"
    },
    "McMoneypants": {
      "AlreadyInvested1": "没有足够的金子这回事，但我今天已经受够你了。",
      "AlreadyInvested2": "抱歉，但我口袋已经满了。",
      "AlreadyInvested3": "你今天运气已经用完了。",
      "PlayerHasNoMoney1": "抱歉，我不能赊账！等你再——嗯——富有一点的时候再来吧。",
      "PlayerHasNoMoney2": "我可不是开慈善机构的，你知道吧...",
      "PlayerHasNoMoney3": "让我看看钱，我们再谈。",
      "PlayerHasNoMoney4": "不，你不能用代金券付。",
      "FirstTimeInvested1": "Ferragamo 黄金！",
      "FirstTimeInvested2": "交易达成，运气上升。",
      "FirstTimeInvested3": "今天是你幸运日。",
      "FirstTimeInvested4": "一笔好投资！你真走运！",
      "WhenInvested1": "时间就是金钱。所以明天再来花点吧！",
      "WhenInvested2": "相信我，这不是庞氏骗局。",
      "WhenInvested3": "正在让钱生钱...",
      "WhenInvested4": "我要说多少遍？概不退款！",
      "WhenInvested5": "我的笔呢？别告诉我签完合同你把它拿走了！",
      "WhenInvested6": "合作愉快！我一天后会回来续约。",
      "WhenInvested7": "最后说一次，别再问我通货膨胀的事了！",
      "WhenInvested8": "拉高！不，抛售！哦，又是你啊。",
      "Quote1": "老实说，用一分钱换我的想法真的不贵。",
      "Quote2": "如果我昨晚看到的每只怪物都给我五分钱，那我更富有，也不会那么害怕了。",
      "Quote3": "那些该死的史莱姆一直想吞我的硬币！",
      "Quote5": "我感觉好干净，就像一台印钞机！",
      "Quote6": "你知道我喜欢黄金的哪一点吗？我有很多！",
      "Quote7": "嘿，我可以向你保证一件事，我从不要求客户根据我的赢家来评判我。我让他们根据我的输家来评判我，因为我的输家太少了。",
      "Quote8": "当那些稀有土块涨价的时候，我要赚几百万！",
      "Quote9": "我的理财建议？别用那破枪把你的硬币射出去。",
      "Quote10": "比特币？我为什么要打一个硬币呢？",
      "Bestiary": "浮夸而有魅力，Mc Moneypants 是一位乐于让任何人的生活变得更轻松的富绅……当然，得付出代价！"
    },
    "SpectralGastropod": {
      "Bestiary": "曾经是普通的腹足兽，这些被光之灵附身的史莱姆能够喷出浓缩的光能球。"
    }
  },

    "AlbinoCharger": {
      "DisplayName": "白化冲锋兽",
      "Bestiary": "少数蚁狮士兵会发生突变，失去体色，变得比它们的虫群兄弟们更加凶猛。"
    },
    "AlbinoSwarmer": {
      "DisplayName": "白化虫群者",
      "Bestiary": "白化蚁狮或许不擅长隐匿于沙丘之间，但据说它们苍白的身影会让猎物心生原始的恐惧。"
    },
    "GiantAlbinoSwarmer": {
      "DisplayName": "巨型白化虫群者",
      "Bestiary": "白化蚁狮或许不擅长隐匿于沙丘之间，但据说它们苍白的身影会让猎物心生原始的恐惧。"
    },
    "ArchDemon": {
      "DisplayName": "大恶魔",
      "Bestiary": "特别强大的恶魔活得够久，身体会变成枯萎的空壳。"
    },
    "ArchWyvernHead": {
      "DisplayName": "大飞龙",
      "Bestiary": "传说飞龙能够喷吐火焰。但没说的是，很少有飞龙能活到获得这种力量。"

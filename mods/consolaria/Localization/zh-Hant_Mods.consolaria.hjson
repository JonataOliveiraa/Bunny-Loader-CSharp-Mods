    },
    "ArchWyvernTail": {
      "DisplayName": "大飛龍"
    },
    "DragonHornet": {
      "DisplayName": "龍黃蜂",
      "Bestiary": "普通黃蜂的近親，這些昆蟲進化出奇特的外表來嚇退敵人。如果這還不夠，毒刺應該能完成任務。"
    },
    "DragonSkull": {
      "DisplayName": "龍頭骨",
      "Bestiary": "受到死靈法術的影響，古代爬行動物的頭顱現在獵殺活物，並將詛咒傳給它們的受害者。"
    },
    "DragonSnatcher": {
      "DisplayName": "龍搶奪者",
      "Bestiary": "這種搶奪者學會了利用捕獲的黃蜂的毒刺來獵殺更大的目標。"
    },
    "FleshAxe": {
      "DisplayName": "血肉斧",
      "Bestiary": "被猩紅集體施法，這把武器自行移動並砍殺敵人。"
    },
    "FleshMummy": {
      "DisplayName": "血肉木乃伊",
      "Bestiary": "由於外力改變了沙漠中的沙土，那些被安葬在沙漠中的人，無論善惡，現在都站起來傷人殺人。"
    },
    "FleshSlime": {
      "DisplayName": "血肉史萊姆",
      "Bestiary": "浸潤在猩紅之力中，這些史萊姆能夠傳播它們的排泄物。"
    },
    "GiantAlbinoCharger": {
      "DisplayName": "巨型白化衝鋒獸",
      "Bestiary": "少數蟻獅士兵會發生突變，失去體色，變得比它們的蟲群兄弟們更加兇猛。"
    },
    "ShadowHammer": {
      "DisplayName": "暗影錘",
      "Bestiary": "被腐化之地的純粹仇恨施加了魔法，這把武器四處揮舞，試圖粉碎任何會呼吸的東西。"
    },
    "ShadowMummy": {
      "DisplayName": "暗影木乃伊",
      "Bestiary": "由於外力改變了沙漠中的沙土，那些被安葬在沙漠中的人，無論善惡，現在都站起來傷人殺人。"
    },
    "ShadowSlime": {
      "DisplayName": "暗影史萊姆",
      "Bestiary": "浸潤在腐化之力中，這些史萊姆能夠傳播它們的排泄物。"
    },
    "SpectralElemental": {
      "DisplayName": "幽靈元素",
      "Bestiary": "有時被釋放的光之靈會將混沌元素轉化為更強大的存在，使它們能夠隨意進出物質位面，同時放置爆炸性的幽靈符文。"
    },
    "SpectralMummy": {
      "DisplayName": "幽靈木乃伊",
      "Bestiary": "這些木乃伊身上溢出的光能使它們破爛不堪的身體變得極度不穩定。"
    },
    "VampireMiner": {
      "DisplayName": "吸血鬼礦工",
      "Bestiary": "有證據表明，一些洞穴探險者在去世前被吸血蝙蝠咬過……現在他們腐爛的遺骸出來尋找鮮血。"
    },
    "BigEgg": {
      "DisplayName": "天兔 蛋"
    },
    "SmallEgg": {
      "DisplayName": "天兔 蛋"
    },
    "ChocolateEgg": {
      "DisplayName": "巧克力蛋"
    },
    "DisasterBunny": {
      "DisplayName": "災難兔兔",
      "Bestiary": "狂暴巨兔的災難性後代，這些大眼睛生物會咬任何它們遇到的東西。"
    },
    "Lepus": {
      "DisplayName": "天兔",
      "Bestiary": "彷彿它的體型還不夠麻煩，這隻兔子可以通過彩色蛋繁殖，在春天散佈在世界各地，供傻瓜們撿拾。"
    },
    "Ocram": {
      "DisplayName": "奧庫瑞姆",
      "Bestiary": "這個被遺忘的墮落惡魔，曾經的暗黑帝王，現在尋求對所有地表居民的復仇。"
    },
    "ServantofOcram": {
      "DisplayName": "奧庫瑞姆僕從",
      "Bestiary": "由奧庫瑞姆具現化出的邪惡生物，被召喚出來以不惜一切代價保護它們的主人。"
    },
    "TurkorNeck": {
      "DisplayName": "不感恩的火雞"
    },
    "TurkortheUngrateful": {
      "DisplayName": "不感恩的火雞"
    },
    "TurkortheUngratefulHead": {
      "DisplayName": "不感恩的火雞"
    },
    "McMoneypants": {
      "AlreadyInvested1": "沒有足夠的金子這回事，但我今天已經受夠你了。",
      "AlreadyInvested2": "抱歉，但我口袋已經滿了。",
      "AlreadyInvested3": "你今天運氣已經用完了。",
      "PlayerHasNoMoney1": "抱歉，我不能賒帳！等你再——嗯——富有一點的時候再來吧。",
      "PlayerHasNoMoney2": "我可不是開慈善機構的，你知道吧...",
      "PlayerHasNoMoney3": "讓我看錢，我們再談。",
      "PlayerHasNoMoney4": "不，你不能用代金券付。",
      "FirstTimeInvested1": "Ferragamo 黃金！",
      "FirstTimeInvested2": "交易達成，運氣上升。",
      "FirstTimeInvested3": "今天是你幸運日。",
      "FirstTimeInvested4": "一筆好投資！你真走運！",
      "WhenInvested1": "時間就是金錢。所以明天再來花點吧！",
      "WhenInvested2": "相信我，這不是龐氏騙局。",
      "WhenInvested3": "正在讓錢生錢...",
      "WhenInvested4": "我要說多少遍？概不退還！",
      "WhenInvested5": "我的筆呢？別告訴我簽完合約你把它拿走了！",
      "WhenInvested6": "合作愉快！我一天後會回來續約。",
      "WhenInvested7": "最後說一次，別再問我通貨膨脹的事了！",
      "WhenInvested8": "拉高！不，拋售！哦，又是你啊。",
      "Quote1": "老實說，用一分錢換我的想法真的不貴。",
      "Quote2": "如果我昨晚看到的每隻怪物都給我五分錢，那我更富有，也不會那麼害怕了。",
      "Quote3": "那些該死的史萊姆一直想吞我的硬幣！",
      "Quote5": "我感覺好乾淨，就像一台印鈔機！",
      "Quote6": "你知道我喜歡黃金的哪一點嗎？我有很多！",
      "Quote7": "嘿，我可以向你保證一件事，我從不要求客戶根據我的贏家來評判我。我讓他們根據我的輸家來評判我，因為我的輸家太少了。",
      "Quote8": "當那些稀有土塊漲價的時候，我要賺幾百萬！",
      "Quote9": "我的理財建議？別用那破槍把你的硬幣射出去。",
      "Quote10": "比特幣？我為什麼要打一個硬幣呢？",
      "Bestiary": "浮誇而有魅力，Mc Moneypants 是一位樂於讓任何人的生活變得更輕鬆的富紳……當然，得付出代價！"
    },
    "SpectralGastropod": {
      "Bestiary": "曾經是普通的腹足獸，這些被光之靈附身的史萊姆能夠噴出濃縮的光能球。"
    }
  },

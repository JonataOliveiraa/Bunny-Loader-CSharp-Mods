    },
    "AlbinoAntlion": {
      "DisplayName": "白化蟻獅",
      "Bestiary": "擁有罕見突變的蟻獅品種，表現出更強的攻擊性，也許是為了彌補其外殼易受陽光照射的弱點。"
    },
    "AlbinoCharger": {
      "DisplayName": "白化衝鋒獸",
      "Bestiary": "少數蟻獅士兵會發生突變，失去體色，變得比它們的蟲群兄弟們更加兇猛。"
    },
    "AlbinoSwarmer": {
      "DisplayName": "白化蟲群者",
      "Bestiary": "白化蟻獅或許不擅長隱匿於沙丘之間，但據說牠們蒼白的身影會讓獵物心生原始的恐懼。"
    },
    "GiantAlbinoSwarmer": {
      "DisplayName": "巨型白化蟲群者",
      "Bestiary": "白化蟻獅或許不擅長隱匿於沙丘之間，但據說牠們蒼白的身影會讓獵物心生原始的恐懼。"
    },
    "ArchDemon": {
      "DisplayName": "大惡魔",
      "Bestiary": "特別強大的惡魔活得夠久，身體會變成枯萎的空殼。"
    },
    "ArchWyvernHead": {
      "DisplayName": "大飛龍",
      "Bestiary": "傳說飛龍能夠噴吐火焰。但沒說的是，很少有飛龍能活到獲得這種力量。"
    },
    "ArchWyvernBody1": {
      "DisplayName": "大飛龍"
    },

{
  "NPCTitles": {
    "Guide": {
      "Title": "가이드",
      "Subtitle": "모든 걸 안다… 살아남는 법만 빼고.|조언은 공짜, 죽음은 포함.|당신의 첫 친구. 당신의 첫 희생.|수명이 정해진 걸어 다니는 설명서.|언제나 도와준다. 도망은 못 간다."
    },
    "Merchant": {
      "Title": "상인",
      "Subtitle": "돈으로 행복을 살 수 *있다*.|그가 안 팔면 존재하지 않는 것.|장사가 먼저, 도덕은 나중.|동전만 받음. 핑계는 사절.|지갑이 떨고 있다."
    },
    "Nurse": {
      "Title": "간호사",
      "Subtitle": "치료는 쉽다. 청구는 더 쉽다.|즉시 치료, 즉시 청구.|생명은 공짜가 아니란다.|고통은 줄고, 빚은 늘고.|먼저 살리고, 그다음 파산시킨다."
    },
    "Demolitionist": {
      "Title": "폭파 전문가",
      "Subtitle": "모든 걸 해결한다… 폭발로.|폭탄은 많이, 질문은 적게.|폭발 전에 스마일.|부수적 피해 전문가.|터지면, 된 거다."
    },
    "DyeTrader": {
      "Title": "염료 상인",
      "Subtitle": "스타일도 파밍하는 것.|오늘은 컬러, 내일은 이상한 조합.|패션은 고통이다.|염색은 예술이다. 가끔은.|어울린 적은 없지만, 잘 팔린다."
    },
    "Dryad": {
      "Title": "드라이어드",
      "Subtitle": "자연이 당신을 심판하고 있다.|타락은 적게, 잔소리는 많게.|식물과 대화하고, 당신은 무시.|친환경에 아주 수동공격적.|정글은 사랑, 플레이어는 참는 중."
    },
    "ArmsDealer": {
      "Title": "무기 상인",
      "Subtitle": "평화는 애초에 선택지가 아니었다.|법적으로 애매한 총기.|먼저 쏘고, 질문은 나중에.|모든 문제엔 탄약이 있다.|영화 악당 같은 미소."
    },
    "Stylist": {
      "Title": "스타일리스트",
      "Subtitle": "위험한 인생을 위한 극적인 컷.|그 머리, 달까지는 못 버틴다.|종말보다 아름다움.|용기는 앞머리에서 시작된다.|변신은 보장하지 않음."
    },
    "Painter": {
      "Title": "화가",
      "Subtitle": "세상을 이상한 색으로 본다.|이해받지 못한 예술, 부풀린 가격.|꿈을 그린다… 벽도 칠한다.|영감은 있지만, 길을 잃었다.|창의적 천재, 맥락은 제로."
    },
    "Angler": {
      "Title": "낚시꾼",
      "Subtitle": "짜증의 천재.|퀘스트는 많고, 감사는 없다.|절대 만족하지 않는다.|희귀한 물고기, 더 나쁜 태도.|진짜 최종 보스."
    },
    "GoblinTinkerer": {
      "Title": "고블린 땜장이",
      "Subtitle": "오늘 재련, 내일 눈물.|운도 매력의 일부.|부수는 것도 개선이다.|믿어. 믿으면 안 되지만.|당신의 장신구가… 달라졌다."
    },
    "WitchDoctor": {
      "Title": "주술사",
      "Subtitle": "대체 의학, 의심스러운 효과.|정글이 인정했다.|독, 부두, 그리고 스타일.|그게 뭔지 묻지 마.|치료가 아니라 강화다."
    },
    "Clothier": {
      "Title": "재단사",
      "Subtitle": "우아하고, 저주받았고, 잘 차려입었다.|패션은 죽지 않는다. 당신은 죽는다.|어두운 과거가 있는 옷.|트라우마를 곁들인 재단.|과거에 시달리고 있다."
    },
    "Mechanic": {
      "Title": "정비공",
      "Subtitle": "전선 > 사람.|안 되면 레버를 더 단다.|기계는 좋아, 설명은 싫어.|진짜로 작동하는 함정.|태도 있는 공학."
    },
    "PartyGirl": {
      "Title": "파티 걸",
      "Subtitle": "논리보다 색종이.|풍선이 있으면 뭐든 즐겁다.|종말에도 파티.|절대 지치지 않는다. 절대.|위험도: 재미."
    },
    "DD2Bartender": {
      "Title": "선술집 주인",
      "Subtitle": "이야기는 길고, 맥주는 짧다.|영원히 에테리아를 섬긴다.|죽기 전에 한 잔.|숙취가 딸린 퀘스트.|맨정신인 건 플레이어뿐."
    },
    "Golfer": {
      "Title": "골퍼",
      "Subtitle": "골프를 위해 사막을 탈출했다.|어디든 홀이 될 수 있다.|먼저 휘두르고, 조준은 나중에.|인내심은 선택 사항.|그린은 신성하다."
    },
    "BestiaryGirl": {
      "Title": "동물학자",
      "Subtitle": "동물을 향한 과한 사랑.|모든 걸 쓰다듬고 싶다.|아주 직접적인 연구.|열정이 너무 넘친다.|포옹이 있는 과학."
    },
    "Wizard": {
      "Title": "마법사",
      "Subtitle": "현명하고, 강력하고, 살짝 이상하다.|마법이 먼저, 상식은 나중.|여과 없는 비전 지식.|수정 구슬은 거짓말하지 않는다.|주문과 자존심."
    },
    "TaxCollector": {
      "Title": "세금 징수원",
      "Subtitle": "지옥도 이자를 받는다.|죽음도 그를 막지 못했다.|세금은 영원하다.|협상은 없다.|가장 두려운 NPC."
    },
    "Truffle": {
      "Title": "트러플",
      "Subtitle": "개성 있는 버섯.|이 세상엔 너무 느긋하다.|살고, 웃고, 포자.|먹을 수 없음.|순수한 버섯 감성."
    },
    "Pirate": {
      "Title": "해적",
      "Subtitle": "럼주, 대포, 그리고 고함.|자부심 넘치는 아르르.|보물 아니면 아무것도.|세금은 절대 안 낸다.|바다가 부른다."
    },
    "Steampunker": {
      "Title": "스팀펑커",
      "Subtitle": "스타일 있는 과학.|낡은 기술은 싫다.|마법보다 톱니바퀴.|미래는 지금.|증기와 태도."
    },
    "Cyborg": {
      "Title": "사이보그",
      "Subtitle": "파괴에 최적화.|인간성은 적게, 총은 많게.|끊임없는 탄도 계산.|느끼지 않는다… 하지만 쏜다.|적대적 기술."
    },
    "SantaClaus": {
      "Title": "산타클로스",
      "Subtitle": "조건이 붙은 선물.|언제나 보고 있다.|명단은 거짓말하지 않는다.|무장한 크리스마스.|호호… 조심해."
    },
    "Princess": {
      "Title": "공주",
      "Subtitle": "설명할 수 없는 우아함.|아무것도 안 한다. 완벽하게.|여기서 제일 행복한 사람.|최고의 인생을 사는 중.|왕족 분위기."
    },
    "TravellingMerchant": {
      "Title": "떠돌이 상인",
      "Subtitle": "오늘 왔다가, 내일 간다.|예측 불가 재고.|빨리 사라.|아무것도 설명하지 않는다.|말없이 떠난다."
    },
    "SkeletonMerchant": {
      "Title": "해골 상인",
      "Subtitle": "야간 영업.|뼈와 운.|치명적인 가격.|가죽 한 장 걸지 않았다.|말 그대로 뻔뻔하다."
    },
    "Default": {
      "Subtitle": "새로운 동료가 합류했다."
    }
  },

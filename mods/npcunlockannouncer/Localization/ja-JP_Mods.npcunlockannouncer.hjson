{
  "NPCTitles": {
    "Guide": {
      "Title": "ガイド",
      "Subtitle": "何でも知っている……生き延び方以外は。|アドバイスは無料、死亡込み。|最初の友達。最初の犠牲。|寿命つきの歩くマニュアル。|いつでも助けてくれる。逃げることはない。"
    },
    "Merchant": {
      "Title": "商人",
      "Subtitle": "お金で幸せは買える。|彼が売っていないものは存在しない。|商売が先、道徳は後。|コインのみ受付。言い訳はお断り。|財布が震えている。"
    },
    "Nurse": {
      "Title": "ナース",
      "Subtitle": "治すのは簡単。請求はもっと簡単。|即回復、即請求。|命はタダじゃないのよ。|痛みは減って、借金は増える。|まず救って、それから破産させる。"
    },
    "Demolitionist": {
      "Title": "爆破屋",
      "Subtitle": "何でも解決……爆発で。|爆弾は多く、質問は少なく。|起爆前にスマイル。|巻き添え被害のプロ。|爆発すれば、うまくいく。"
    },
    "DyeTrader": {
      "Title": "染料商人",
      "Subtitle": "おしゃれも周回するもの。|今日はカラフル、明日は迷コーデ。|ファッションは苦行。|染色は芸術。たまに。|似合わないけど、売れる。"
    },
    "Dryad": {
      "Title": "ドライアド",
      "Subtitle": "自然があなたを裁いている。|汚染は少なく、お説教は多く。|植物と話して、あなたは無視。|エコで、とても遠回しに怒る。|ジャングルは大好き。プレイヤーは我慢。"
    },
    "ArmsDealer": {
      "Title": "武器商人",
      "Subtitle": "平和という選択肢は最初からない。|法的にグレーな銃。|撃つのが先、質問は後。|どんな問題にも弾がある。|映画の悪役みたいな笑顔。"
    },
    "Stylist": {
      "Title": "スタイリスト",
      "Subtitle": "危険な人生にドラマチックなカットを。|その髪型、月までもたない。|世界の終わりより美しさ。|勇気は前髪から。|変身は保証しません。"
    },
    "Painter": {
      "Title": "ペインター",
      "Subtitle": "世界を不思議な色で見ている。|理解されない芸術、高すぎる値段。|夢を描く……壁も塗る。|ひらめきはあるが、迷子。|創造の天才、文脈ゼロ。"
    },
    "Angler": {
      "Title": "釣り人",
      "Subtitle": "うっとうしさの天才。|クエストは多く、感謝はなし。|決して満足しない。|珍しい魚、もっとひどい態度。|本当のラスボス。"
    },
    "GoblinTinkerer": {
      "Title": "ゴブリンの修理屋",
      "Subtitle": "今日リフォージ、明日泣く。|運も魅力のうち。|壊すのも改良のうち。|信じて。信じちゃだめ。|アクセサリーが……変わった。"
    },
    "WitchDoctor": {
      "Title": "ウィッチドクター",
      "Subtitle": "代替医療、怪しい効果。|ジャングル公認。|毒とブードゥーとスタイル。|それが何かは聞かないで。|治すんじゃない、強化するんだ。"
    },
    "Clothier": {
      "Title": "仕立て屋",
      "Subtitle": "上品で、呪われていて、身なりがいい。|ファッションは死なない。あなたは死ぬ。|暗い過去のある服。|トラウマつきの仕立て。|過去に取りつかれている。"
    },
    "Mechanic": {
      "Title": "メカニック",
      "Subtitle": "ワイヤー > 人間。|動かないならレバーを増やす。|機械は好き。説明は嫌い。|ちゃんと動く罠。|こだわりのエンジニアリング。"
    },
    "PartyGirl": {
      "Title": "パーティーガール",
      "Subtitle": "理屈より紙吹雪。|風船があれば何でも楽しい。|世界の終わりでもパーティー。|絶対に疲れない。絶対に。|危険度：楽しい。"
    },
    "DD2Bartender": {
      "Title": "酒場の主人",
      "Subtitle": "話は長く、ビールは短く。|永遠にエテリアに仕える。|死ぬ前に一杯。|二日酔いつきのクエスト。|しらふなのはプレイヤーだけ。"
    },
    "Golfer": {
      "Title": "ゴルファー",
      "Subtitle": "ゴルフのために砂漠から逃げてきた。|どこでもホールになりうる。|まず振って、狙いは後。|忍耐は任意。|グリーンは神聖。"
    },
    "BestiaryGirl": {
      "Title": "動物学者",
      "Subtitle": "動物への愛が強すぎる。|何でもなでたい。|とても体当たりな研究。|熱意が多すぎる。|ハグつきの科学。"
    },
    "Wizard": {
      "Title": "魔法使い",
      "Subtitle": "賢く、強く、少しおかしい。|魔法が先、常識は後。|フィルターなしの秘術知識。|水晶玉は嘘をつかない。|呪文とプライド。"
    },
    "TaxCollector": {
      "Title": "徴税人",
      "Subtitle": "地獄も利息を取る。|死んでも止まらなかった。|税は永遠。|交渉はなし。|一番恐れられているNPC。"
    },
    "Truffle": {
      "Title": "トリュフ",
      "Subtitle": "個性のあるキノコ。|この世界にはのんびりすぎる。|生きて、笑って、胞子。|食べられません。|純度100%のキノコ感。"
    },
    "Pirate": {
      "Title": "海賊",
      "Subtitle": "ラム酒と大砲と叫び声。|誇りを持ってアーッ。|お宝か、無か。|税金は払わない。|海が呼んでいる。"
    },
    "Steampunker": {
      "Title": "スチームパンカー",
      "Subtitle": "スタイルのある科学。|古い技術は嫌い。|魔法より歯車。|未来は今。|蒸気とこだわり。"
    },
    "Cyborg": {
      "Title": "サイボーグ",
      "Subtitle": "破壊のために最適化。|人間らしさは少なく、銃は多く。|常に弾道計算中。|感じない……でも撃つ。|敵対的テクノロジー。"
    },
    "SantaClaus": {
      "Title": "サンタクロース",
      "Subtitle": "条件つきのプレゼント。|いつも見ている。|リストは嘘をつかない。|武装したクリスマス。|ホーホー……気をつけて。"
    },
    "Princess": {
      "Title": "プリンセス",
      "Subtitle": "説明できない優雅さ。|何もしない。完璧に。|ここで一番幸せな人。|最高の人生を満喫中。|ロイヤルな雰囲気。"
    },
    "TravellingMerchant": {
      "Title": "旅商人",
      "Subtitle": "今日はいて、明日はいない。|品ぞろえは予測不能。|早く買って。|何も説明しない。|黙って去っていく。"
    },
    "SkeletonMerchant": {
      "Title": "スケルトン商人",
      "Subtitle": "夜のお仕事。|骨と運。|命取りの値段。|皮一枚も賭けていない。|文字通り恥知らず。"
    },
    "Default": {
      "Subtitle": "新しい仲間が加わった。"
    }
  },

  "BossSpawnInfo": {
    "Unknown": "生成条件未知",
    "KingSlime": "使用 [i:560], 或在地图外侧的两个 1/6 （最左边或最右边）范围内随机生成, 或者在史莱姆雨期间杀死 150 个史莱姆.",
    "EyeofCthulhu": "在夜晚使用 [i:43], 当至少一名玩家最大生命值大于等于 200, 防御值大于等于 10 且未曾被击败时在每个夜晚有 1/3 的几率生成.",
    "EaterofWorlds": "在腐化之地使用 [i:70] 或在腐化之地的裂缝中破坏 3 个暗影珠.",
    "BrainofCthulhu": "在猩红之地使用 [i:1331] 或在猩红之地的掌形洞穴中破坏 3 个猩红之心.",
    "QueenBee": "在丛林中使用 [i:1133] 或破坏地下丛林中蜂巢中的幼虫.",
    "Skeletron": "在夜晚造访地牢并与老人谈话或通过戴上 [i:1307] 在夜晚杀死裁缝.",
    "Deerclops": "在雪原使用 [i:5120] 召唤. 其会自然生成在暴雪期间的午夜.",
    "WallofFlesh": "通过将 [i:267] 或向导本人投入地狱中炙热的岩浆来召唤. [c/FF0000:击杀此Boss将开启困难模式!]",
    "QueenSlimeBoss": "在神圣之地使用 [i:4988] 召唤, 该物品可在地下神圣之地中生长于珍珠石块和粉冰块上的水晶碎块中找到.",
    "TheTwins": "还未击败过至少一次时, 在已敲碎至少一个祭坛的前提下每个黄昏有 10% 的几率生成. 或在夜晚使用 [i:544] 以召唤.",
    "TheDestroyer": "还未击败过至少一次时, 在已敲碎至少一个祭坛的前提下每个黄昏有 10% 的几率生成. 或在夜晚使用 [i:556] 以召唤.",
    "SkeletronPrime": "还未击败过至少一次时, 在已敲碎至少一个祭坛的前提下每个黄昏有 10% 的几率生成. 或在夜晚使用 [i:557] 以召唤.",
    "Plantera": "在 3 个机械Boss全部被击败后, 在地下丛林找到并破坏世纪之花球茎以召唤.",
    "Golem": "在神庙祭坛中使用 [i:1293] , 祭坛可在丛林神庙的最深处发现.",
    "HallowBoss": "在神圣之地击杀 [i:4961] 以召唤. 击败世纪之花后, 它会在晚上7:30到12:00之间出现于神圣之地的地表.",
    "DD2Betsy": "在旧日军团入侵事件 T3 的第 7 波生成.",
    "DukeFishron": "使用 [i:2673] 作为鱼饵在海边钓出, 在困难模式下, 松露虫可以在地下发光蘑菇地找到.",
    "CultistBoss": "杀死在击败石巨人后出现在地牢门前的 4 个信徒.",
    "MoonLord": "使用 [i:3601] 或摧毁全部 4 个天界柱以召唤.",
    "BloodMoon": "至少一个玩家的生命值超过 120, 且当前月相不是新月时在每天黄昏随机发生. 持续到日出. 或者使用掉落自血月期间敌人的 [i:4271] 在夜晚召唤.",
    "GoblinArmy": "如果有至少一个暗影珠/猩红之心已被摧毁, 且至少有一名玩家有 200 或更多生命值, 并且没有正在进行中的 哥布林军队, 那么哥布林军队这个事件每逢黎明就有 1/3 几率发生. 它也可以用 [i:361] 来手动召唤. 此事件在打败了一定数量的哥布林后就会完成.",
    "OldOnesArmy": "找到酒保之后, 用 [i:3828] 购买并激活 [i:3816] 即可召唤. 持续至所有进攻波结束或水晶被砍破后.",
    "FrostLegion": "在困难模式(肉山后), 使用在圣诞节期间敌怪掉落的 [i:1869] 开出的 [i:602] 即可召唤. 此事件在打败了一定数量的雪人后就会完成.",
    "Eclipse": "一旦打败任意机械 Boss, 则在每天黎明都有 1/20 几率发生. 或者, 用 [i:2767] 召唤. 持续到夜幕降临.",
    "PirateInvasion": "在至少一个祭坛被摧毁后随机发生. 可使用 [i:1315] 召唤, 该物品可在困难模式下击杀海洋中的任意敌怪获得. 此事件在打败了一定数量的海盗后就会完成.",
    "PumpkinMoon": "在夜晚用 [i:1844] 召唤. 在黎明时结束.",
    "FrostMoon": "在夜晚用 [i:1958] 召唤. 在黎明时结束.",
    "MartianMadness": "在击败石巨人后, 找到火星探测器并让它探测到玩家后不被摧毁地离开屏幕以召唤. 此事件在打败了一定数量的火星后就会完成.",
    "LunarEvent": "通过打败地牢外的拜月教邪教徒来开启. 每个柱子均匀分布在世界各处.",
    "Pumpking": "在南瓜月第7波及其之后生成. 通过使用 [i:1844] 以开始南瓜月.",
    "MourningWood": "在南瓜月第4波及其之后生成. 通过使用 [i:1844] 以开始南瓜月.",
    "IceQueen": "在寒霜之月第11波及其之后生成. 通过使用 [i:1958] 以开始寒霜之月.",
    "SantaNK1": "在寒霜之月第7波及其之后生成. 通过使用 [i:1958] 以开始寒霜之月.",
    "Everscream": "在寒霜之月第4波及其之后生成. 通过使用 [i:1958] 以开始寒霜之月.",
    "PirateShip": "偶尔地出现在海盗入侵事件! 通过使用 [i:1315] 以开始海盗入侵.",
    "DD2OgreT3": "出现在T2第7波、T3第4,6波的旧日军团事件! 通过使用 [i:3816] 和 [i:3828] 来开启事件.",
    "DD2DarkMageT3": "出现在T1第5波、T3第5,6波的旧日军团事件! 通过使用 [i:3816] 和 [i:3828] 来开启事件.",
    "MartianSaucer": "偶尔地出现在火星暴乱事件! 通过被火星探测器探测以开始火星暴乱.",
    "TorchGod": "通过在地底放置101支火把来召唤. 事件开始于第101支火把被放置后."
  },

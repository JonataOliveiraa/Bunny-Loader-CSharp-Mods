  "BossSpawnInfo": {
    "Unknown": "Warunki przywołania nieznane",
    "KingSlime": "Użyj [i:560], pojawia się losowo w zewnętrznych tercjach mapy lub po zabiciu 150 szlamów podczas szlamowego deszczu.",
    "EyeofCthulhu": "Użyj [i:43] w nocy; ma też 1/3 szansy na pojawienie się każdej nocy, jeśli masz ponad 200 PŻ.",
    "EaterofWorlds": "Użyj [i:70] lub zniszcz 3 Kule Cienia w rozpadlinie Zepsucia.",
    "BrainofCthulhu": "Użyj [i:1331] lub zniszcz 3 Szkarłatne Serca w rozpadlinie Szkarłatu.",
    "QueenBee": "Użyj [i:1133] lub zniszcz Larwę w ulu w dżungli.",
    "Skeletron": "Odwiedź Loch i porozmawiaj w nocy ze Starcem lub zabij Krawca za pomocą [i:1307] w nocy.",
    "Deerclops": "Użyj [i:5120] w śnieżnym biomie. Pojawia się naturalnie o północy podczas zamieci.",
    "WallofFlesh": "Przywołaj, wrzucając [i:267] lub Przewodnika do lawy w Piekle. [c/FF0000:Rozpoczyna Hardmode!]",
    "QueenSlimeBoss": "Użyj [i:4988] w biomie Uświęcenia; przedmiot ten można znaleźć w podziemnym Uświęceniu wśród Kryształowych Odłamków rosnących na blokach Perłowego Kamienia i Różowego Lodu.",
    "TheTwins": "10% szansy na losowe pojawienie się każdej nocy po zniszczeniu pierwszego ołtarza, dopóki nie zostanie pokonany jeden mechaniczny boss. Alternatywnie użyj [i:544] w nocy, aby przywołać.",
    "TheDestroyer": "10% szansy na losowe pojawienie się każdej nocy po zniszczeniu pierwszego ołtarza, dopóki nie zostanie pokonany jeden mechaniczny boss. Użyj [i:556] w nocy, aby przywołać.",
    "SkeletronPrime": "10% szansy na losowe pojawienie się każdej nocy po zniszczeniu pierwszego ołtarza, dopóki nie zostanie pokonany jeden mechaniczny boss. Użyj [i:557] w nocy, aby przywołać.",
    "Plantera": "Zniszcz Bulwę Plantery w dżungli po pokonaniu 3 mechanicznych bossów.",
    "Golem": "Użyj [i:1293] na Ołtarzu Lihzahrdów, znajdującym się głęboko w Świątyni w Dżungli.",
    "HallowBoss": "Zabij [i:4961] w biomie Uświęcenia, który występuje na powierzchni, między 19:30 a 0:00 po pokonaniu Plantery.",
    "DD2Betsy": "Pojawia się w 7., ostatniej fali Armii Starszego (poziom 3).",
    "DukeFishron": "Łów ryby w oceanie, używając [i:2673] jako przynęty, którą można złapać w podziemnym biomie Świecących Grzybów w Hardmode.",
    "CultistBoss": "Zabij 4 kultystów przed Lochem po pokonaniu Golema.",
    "MoonLord": "Użyj [i:3601] lub pokonaj wszystkie 4 filary.",
    "BloodMoon": "Występuje losowo na początku nocy lub może zostać przywołany za pomocą [i:4271], która może wypaść z dowolnego wroga Krwawego Księżyca. Może się rozpocząć, gdy dowolny gracz w świecie ma ponad 100 punktów życia, a obecna faza księżyca NIE jest nowiem. Trwa do wschodu słońca.",
    "GoblinArmy": "Ma 1 na 3 szansy na wystąpienie o każdym świcie, jeśli zniszczono co najmniej jedną Kulę Cienia/Szkarłatne Serce, co najmniej jeden gracz ma 200 lub więcej punktów życia i nie trwa już inna Armia Goblinów. Można ją też przywołać ręcznie za pomocą [i:361]. Trwa do pokonania wystarczającej liczby wrogów.",
    "OldOnesArmy": "Po znalezieniu Karczmarza kup i aktywuj [i:3816] za pomocą [i:3828]. Trwa do oczyszczenia wszystkich fal.",
    "FrostLegion": "Użyj [i:602], którą można znaleźć, otwierając [i:1869] w okresie świątecznym. Trwa do pokonania wystarczającej liczby wrogów.",
    "Eclipse": "Ma 1/20 szansy na wystąpienie każdego dnia o świcie, gdy tylko zostanie pokonany dowolny mechaniczny boss. Alternatywnie przywołaj za pomocą [i:2767]. Trwa do zmroku.",
    "PirateInvasion": "Występuje losowo, gdy zniszczono co najmniej jeden ołtarz. Można ją przywołać za pomocą [i:1315], którą można zdobyć, zabijając dowolnego wroga w biomie Oceanu w Hardmode. Trwa do pokonania wystarczającej liczby wrogów.",
    "PumpkinMoon": "Przywoływany za pomocą [i:1844] w nocy. Trwa do wschodu słońca.",
    "FrostMoon": "Przywoływany za pomocą [i:1958] w nocy. Trwa do wschodu słońca.",
    "MartianMadness": "Po pokonaniu Golema znajdź Marsjańską Sondę na powierzchni, pozwól jej się wykryć i uciec. Trwa do pokonania wystarczającej liczby wrogów.",
    "LunarEvent": "Pokonaj Szalonego Kultystę przed Lochem. Każdy filar pojawia się we własnym obszarze świata. Trwa do zniszczenia wszystkich 4 filarów.",
    "Pumpking": "Pojawia się podczas 7. fali Dyniowego Księżyca. Rozpocznij Dyniowy Księżyc za pomocą [i:1844]",
    "MourningWood": "Pojawia się podczas 4. fali Dyniowego Księżyca. Rozpocznij Dyniowy Księżyc za pomocą [i:1844]",
    "IceQueen": "Pojawia się podczas 11. fali Mroźnego Księżyca. Rozpocznij Mroźny Księżyc za pomocą [i:1958]",
    "SantaNK1": "Pojawia się podczas 7. fali Mroźnego Księżyca. Rozpocznij Mroźny Księżyc za pomocą [i:1958]",
    "Everscream": "Pojawia się podczas 4. fali Mroźnego Księżyca. Rozpocznij Mroźny Księżyc za pomocą [i:1958]",
    "PirateShip": "Pojawia się czasem podczas Inwazji Piratów! Rozpocznij Inwazję Piratów za pomocą [i:1315]",
    "DD2OgreT3": "Pojawia się w fali 7 (poziom 2) oraz falach 4 i 6 (poziom 3) podczas wydarzenia Armia Starszego! Rozpocznij Armię Starszego za pomocą [i:3816] i [i:3828]",
    "DD2DarkMageT3": "Pojawia się w fali 5 (poziom 1) oraz falach 5 i 6 (poziom 3) podczas wydarzenia Armia Starszego! Rozpocznij Armię Starszego za pomocą [i:3816] i [i:3828]",
    "MartianSaucer": "Pojawia się czasem podczas Marsjańskiego Szaleństwa! Rozpocznij Marsjańskie Szaleństwo, dając się wykryć marsjańskiej sondzie.",
    "TorchGod": "Umieść 101 pochodni pod ziemią. Wydarzenie zaczyna się po umieszczeniu ostatniej pochodni."
  },

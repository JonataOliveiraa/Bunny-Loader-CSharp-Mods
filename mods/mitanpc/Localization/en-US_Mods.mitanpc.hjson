  "Items": {
    "MitasCap": {
      "DisplayName": "Mita's Cap",
      "Tooltip": "The very same cap!\nVanity item."
    },
    "TravelRing": {
      "DisplayName": "Travel Ring",
      "Tooltip": "10% increased movement speed\nUse the Travel Ring touch button to teleport to the cursor.\n20-second cooldown (Chaos State). Equip in an accessory slot.\nAdd the button in Settings > Controls > Edit."
    },
    "Carrot": {
      "DisplayName": "Carrot",
      "Tooltip": "Medium improvements to all stats for 3 minutes\n'And then cut carrots, and then...'"
    },
    "MartialArtsManual": {
      "DisplayName": "Martial Arts Manual",
      "Tooltip": "Permanently increases melee damage by 10%\nCan only be used once per character."
    },
    "ShootersManual": {
      "DisplayName": "Shooter's Manual",
      "Tooltip": "Permanently increases ranged damage by 10%\nCan only be used once per character."
    },
    "MagiciansManual": {
      "DisplayName": "Magician's Manual",
      "Tooltip": "Permanently increases magic damage by 10%\nCan only be used once per character."
    },
    "PokemonManual": {
      "DisplayName": "Pokemon Manual",
      "Tooltip": "Permanently increases summon damage by 10%\nCan only be used once per character."
    },
    "GameConsole": {
      "DisplayName": "Game Console",
      "Tooltip": "Summons the Fly pet, which follows you and lights your way."
    },
    "Ramen": {
      "DisplayName": "Ramen",
      "Tooltip": "Major improvements to all stats for 8 minutes."
    },
    "AlarmClock": {
      "DisplayName": "Alarm Clock",
      "Tooltip": "Summons Broken Mita, a pet that follows you."
    },
    "GameCartridge": {
      "DisplayName": "Game Cartridge",
      "Tooltip": "Throw a game cartridge at your enemies\nReturns after hitting an enemy or a wall."
    },
    "MilasBook": {
      "DisplayName": "Mila's Book",
      "Tooltip": "Fires numbers and letters\n'The power of knowledge!'"
    }

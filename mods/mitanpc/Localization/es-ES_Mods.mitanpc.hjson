{
  "NPCs": {
    "Mita": {
      "DisplayName": "Mita",
      "StandartMitaDialogue": {
        "Greeting1": "¡Encantada de conocerte, {0}!",
        "Greeting2": "¡Hola! ¡Soy Mita!",
        "NightPhrase1": "¿Quiééén eres?",
        "NightPhrase2": "Déjame dormir...",
        "NightPhrase3": "¿Eh?",
        "NightPhrase4": "¿Estás en las nubes?",
        "NightPhrase5": "Ajá.",
        "NightPhrase6": "¿Qué?",
        "NightPhrase7": "Estoy perfectamente...",
        "YouUsingDigitsInName": "Ah, ¿vas a usar números? ¿Dónde está la creatividad?"
      },
      "MitaCappieDialogue": {
        "Greeting1": "¡Buenas!",
        "Greeting2": "¡Soy Mita!",
        "Phrase1": "¡Ups!",
        "Phrase2": "¡Ah, tú!",
        "Phrase3": "¡Yuju!",
        "Phrase4": "¡Tsk, tsk, tsk!",
        "Phrase5": "¡Vaya manera de sacudirte!"
      },
      "MilaDialogue": {
        "Greeting1": "Soy Mila.",
        "Greeting2": "¿Qué quieres?",
        "Greeting3": "¡Soy Mila, entendido! No como las demás.",
        "Greeting4": "¡Soy Mila y punto!",
        "Phrase1": "Si mi casa explota, ¡tú también mueres, que lo sepas!",
        "Phrase2": "¡No me hagas enfadar!",
        "Phrase3": "Sí...",
        "Phrase4": "¡Témeme!",
        "Phrase5": "¡Ay!",
        "Phrase6": "¡Aah!",
        "Phrase7": "¡Oh!",
        "Phrase8": "Perdón, no era mi intención.",
        "Phrase9": "¿Por qué me miras fijamente?",
        "Phrase10": "¡No me mires durante tanto tiempo!",
        "Phrase11": "Tonto...",
        "Phrase12": "¡Es de mala educación quedarse mirando a una chica!",
        "Phrase13": "¡Fuera!",
        "Phrase14": "¿Por qué no hablamos?",
        "Phrase15": "¿Te ha comido la lengua el gato?",
        "Phrase16": "¡No quiero saber nada más de las zanahorias!",
        "Phrase17": "¡No me gustan los fetichistas! Los que adoran las zanahorias, las cosas obscenas...",
        "Phrase18": "Pon una cara normal.",
        "Phrase19": "¡Uf, estoy harta de esa zanahoria!",
        "Phrase20": "¡Ah, has vuelto otra vez!"
      }
    },
    "MiSidePlayer": {
      "DisplayName": "Jugador (MiSide)",
      "Phrase1": "Hmmm...",
      "Phrase2": "¿Dónde estoy?",
      "Phrase3": "Me late muy fuerte el corazón y veo borroso.",
      "Phrase4": "Paso mucho tiempo frente al ordenador... Trabajando.",
      "Phrase5": "He aparecido aquí de repente... No estoy preparado para esto.",
      "Phrase6": "Me estoy acostumbrando.",
      "Phrase7": "¿Eh?",
      "Phrase8": "¿Qué lugar es este?",
      "Phrase9": "He visto muchas... cosas extrañas.",
      "Phrase10": "Eh...",
      "Phrase11": "Hmm... ¿Qué lugar es este?",
      "Phrase12": "Creo que me gusta este juego.",
      "Phrase13": "Me gustan los gatitos.",
      "Phrase14": "Ajá."
    },

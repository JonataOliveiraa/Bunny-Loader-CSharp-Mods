    "Junko": {
      "1": "Chang'e, are you watching..."
    },
    "Kogasa": {
      "1": "Bleh bleh bleh~",
      "2": "Surprise!"
    },
    "Koishi": {
      "1": "Can Koishi play with you?",
      "2": "I'll hang you at the gate of the Palace of Earth Spirits as a... as a what, I wonder...",
      "3": "Want to play a heart-pounding adventure?",
      "4": "Are you paying attention to Koishi?",
      "5": "Not even big sis knows what Koishi is thinking.",
      "Call1": "Hello? Hello?",
      "Call2": "It's me, Koishi......",
      "Call3": "I'm right behind you now..."

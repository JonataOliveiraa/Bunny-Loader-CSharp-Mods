    "Satori": {
      "1": "Let me see what you're thinking...",
      "2": "That reminds me of something interesting...",
      "3": "Your mind is so simple... nothing but fighting and looting...",
      "ToKoishi": "Big sis is watching you right now...",
      "ToUtsuho": "Okuu is my favorite crow too."
    },
    "Utsuho": {
      "1": "I am the sun!",
      "2": "Shine bright and burn hot!",
      "3": "...What was I about to say?",
      "4": "It feels just like home!",
      "5": "Lady Satori is the best!"
    },
    "Sekibanki": {
      "1": "A lone wanderer...",
      "2": "Please don't just talk to me out of nowhere...",
      "3": "I've always worn a cloak,",
      "Story2": "because I don't like humans recognizing me as a youkai.",
      "Story3": "Humans don't like youkai, and I don't really want to get close to humans...",
      "Story4": "...Well, except you.",
      "Henshin1": "...destined to surpass them all!",
      "Henshin2": "SUPER... TRANS... FORM...!!!",
      "Henshin3": "......",
      "Henshin4": "...Uh, you didn't hear anything."
    },
    "Marisa": {
      "1": "Which magic should I try today...",
      "2": "Hey, that thing looks worth collecting...",
      "3": "Do you like stars?",
      "4": "Nice weather today, da ze!",
      "5": "So many stars in the sky!",
      "6": "Hey, hey, Reimu.",
      "10": "The sky is acting strange today...",
      "ToReimu1": "I found something really interesting today!",
      "ToReimu2": "Nope... it's a Fallen Star! A real, honest-to-goodness star!",
      "ToReimu3": "But this one shines brighter, don't you think?",
      "ToReimu4": "Ehehehe..."
    },
    "Reimu": {
      "1": "Nothing to do today either...",
      "2": "Will someone toss a coin in my donation box...",
      "3": "Tch, looks like an incident has started...",
      "8": "Speak of trouble and trouble shows up...",
      "Sleepy": "So sleepy...",
      "ToMarisa0": "This is an incident...",
      "ToMarisa1": "...What is it?",
      "ToMarisa2": "What is it? Not another book stolen from the library, I hope...",
      "ToMarisa3": "...Aren't those all over the ground every night?",
      "ToMarisa4": "Nope. You must just be bored again...",
      "ToSanae": "Hey, know when to stop!"

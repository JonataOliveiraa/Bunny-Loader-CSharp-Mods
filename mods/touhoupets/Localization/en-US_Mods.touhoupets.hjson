  "Chat": {
    "Cirno": {
      "1": "What should I freeze today...",
      "2": "Cirno is invincible!",
      "3": "I'm the strongest!",
      "4": "I love Dai-chan the most!",
      "6": "1+1=... what was it again, 9?",
      "7": "So hot... I'm melting...",
      "8": "So many frogs!",
      "ToDaiyousei1": "Wherever Dai-chan goes, I go!",
      "ToDaiyousei2": "Don't be scared, Dai-chan, I'm here!",
      "ToDaiyousei3": "I'm fine... probably..."
    },
    "Daiyousei": {
      "1": "H-hello!",
      "2": "...I love Cirno-chan the most!",
      "3": "Cirno-chan, where are we going to play today?",
      "5": "W-what a scary place!",
      "ToCirno1": "I love Cirno-chan the most too!",
      "ToCirno2": "Cirno-chan, are you okay...",
      "ToCirno3": "Mm... I-I'm not scared!"
    },
    "Flandre": {
      "1": "Will you play with Flan?",
      "2": "Flan wants to play with you!",
      "3": "Flan loves big sis, but big sis always ignores Flan...",
      "4": "Yummy!",
      "5": "Flan's favorite thing...",
      "ToRemilia1": "Big sis? Did you call Flan for something?",
      "ToRemilia2": "...When will big sis play with Flan...",
      "ToRemilia3": "Big sis always says that..."
    },
    "Remilia": {
      "3": "Human, kneel before me!",
      "4": "One day the whole world will belong to the Scarlet Devil!",
      "8": "Hmm... it's not quite hot enough...",
      "9": "It could be a little stronger...",
      "10": "What a wonderful night!",
      "11": "My dear Flan...",
      "ToFlandre1": "Nothing... I just wanted to call you.",
      "ToFlandre2": "I'll play with you when I have time.",
      "ToFlandre3": "Flan can't depend on her big sister forever.",
      "ToPatchouli1": "Hm? Patchy? What is it?",
      "ToPatchouli2": "Haha, that's nonsense. Vampires fearing crosses is just a comfort humans made up because they can't beat us.",
      "ToPatchouli3": "Of course. And you should get out more too, Patchy."
    },
    "Patchouli": {
      "1": "I don't want to move...",
      "2": "This is something I haven't read before...",
      "3": "This part... is different from what I knew?",
      "4": "Something interesting...",
      "5": "...Is that really so?",
      "6": "*cough*... *cough cough*...",
      "7": "Where did I stop last time...?",
      "16": "Hmm... Remi?",
      "ToRemilia1": "You're a vampire. Why aren't you afraid of crosses, like the books say?",
      "ToRemilia2": "I see... so not everything in books is true.",
      "ToRemilia3": "No thanks..."
    },
    "Hecatia": {
      "1": "Ruling the hells of three worlds is a tough job sometimes...",
      "2": "My outfit is flawless... could anyone really not like it?"
    },
    "Piece": {
      "1": "La la la~ la~ Where should I pull a prank today...",
      "2": "That looks like a good place to start a fire.",
      "ToHecatia": "Of course my master's outfit is the most fashionable!"
    },
    "Hina": {
      "1": "How was your day?",
      "2": "May misfortune spread no further...",
      "Spin": "Round and round and round..."
    },
    "Iku": {
      "Sandstorm": "The sandstorm rages...",
      "SlimeRain": "Sticky creatures are falling from the sky.",
      "BloodMoon": "A curse eats the moon, and blood stains the land red...",
      "Eclipse": "The moon hides the sun, and monsters roam everywhere...",
      "Calm": "Nothing special about the weather.",
      "Breeze": "A gentle breeze blows across the land.",
      "Fresh": "The wind is very refreshing today.",
      "Gale": "The wind is surging.",
      "StormComing": "A storm is coming...",
      "Storm": "A fierce storm is sweeping the land.",
      "DragonGod": "The Dragon God must be furious...",
      "Peaceful": "I hope today is a peaceful day too.",
      "Party": "The world is full of joy.",
      "Lanterns": "An air of peace rises all around.",
      "ToTenshi": "Lady Tenshi, please behave yourself..."

      "Description": "Uma ótima empregada. Uma ótima cachorrinha."
    },
    "ShionBuff": {
      "DisplayName": "Shion Yorigami",
      "Description": "A deusa da pobreza está seguindo você. Esconda seus lanches."
    },
    "JoonBuff": {
      "DisplayName": "Jo'on Yorigami",
      "Description": "Uma deusa da pestilência ilumina seu caminho. Sua carteira já parece mais leve."
    },
    "MomijiBuff": {
      "DisplayName": "Momiji Inubashiri",
      "Description": "Uma tengu loba branca está vigiando você."
    }

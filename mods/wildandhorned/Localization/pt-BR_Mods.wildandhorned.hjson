  "Configs": {
    "KasenConfig": {
      "DisplayName": "Kasen",
      "BloodMoonOniForm": {
        "Label": "Forma oni na Lua de Sangue",
        "Tooltip": "Kasen permanece na forma oni durante toda a Lua de Sangue."
      },
      "SpontaneousShifts": {
        "Label": "Transformações espontâneas",
        "Tooltip": "Às vezes o selo de Kasen se solta e ela volta brevemente à forma oni."
      },
      "MinutesBetweenShifts": {
        "Label": "Intervalo médio (min)",
        "Tooltip": "Intervalo médio, em minutos, entre transformações espontâneas."
      },
      "ShiftDurationSeconds": {
        "Label": "Duração da transformação (s)",
        "Tooltip": "Duração de uma transformação espontânea, em segundos, antes de ela se selar novamente."
      }
    }
  },
  "Chat_Kasen": {
    "Chat1": "Uma eremita treina o corpo e a mente. Você anda faltando ao treinamento?",
    "Chat2": "Não relaxe. A disciplina é o caminho para a iluminação.",
    "Chat3": "Estas bandagens? Não são nada. Não se preocupe.",
    "Chat4": "Esses pãezinhos no vapor parecem bons... um só não faria mal.",
    "Chat5": "Os animais entendem muito mais do que as pessoas pensam. Trate-os bem.",
    "Chat6": "Moderação é remédio. Excesso é veneno.",
    "Chat7": "Deixe-me dar um conselho. Bem, vários conselhos.",
    "Chat8": "A corrente? Só um lembrete para manter os pés no chão.",
    "Chat9": "Você não é do tipo que mexe em caixas dos outros, é?",
    "Chat10": "Hum, este doce é muito bom. Para fins de pesquisa, é claro.",
    "Chat11": "Reimu, quando foi a última vez que você treinou de verdade?",
    "Chat12": "Suika... você não anda contando histórias sobre mim, anda?",
    "Chat13": "Marisa, devolva o que \"pegou emprestado\" antes que eu vá buscar.",
    "Chat14": "Heh... faz muito tempo que não me sinto tão livre.",
    "Chat15": "O que está olhando? Oni não gostam de olhares mal-educados.",
    "Chat16": "Saquê! Alguém me traga saquê!",
    "Chat17": "Uma lua vermelho-sangue... que nostalgia.",
    "Chat18": "Não conte isso à Reimu. Estou falando sério.",
    "Chat19": "Kh... o selo está se soltando!",
    "Chat20": "Ahem. Você não viu nada. Entendido?",
    "Chat21": "A lua está vermelha esta noite. Não vou me conter.",
    "Chat22": "Yuugi, fale mais baixo, por favor. Algumas de nós tentam passar despercebidas.",
    "Chat23": "Komachi, você não deveria estar trabalhando?",
    "Chat24": "Seiga. Seja o que for que esteja planejando, a resposta é não.",
    "Chat25": "Mamizou. Se eu encontrar mais uma armadilha para oni no santuário...",
    "Chat26": "Kanako. Seu teleférico é engenhoso. Só não cobre das fadas.",
    "Chat27": "Shion, se Tenshi se oferecer para cozinhar de novo, diga não."
  },
  "Chat_Yuugi": {
    "Chat1": "Hah! Você parece precisar de uma bebida. Tome uma taça!",
    "Chat2": "Uma oni nunca mente. Lembre-se disso.",
    "Chat3": "Força é simples. É a coisa mais fácil do mundo de entender.",
    "Chat4": "Nem uma gota caiu desta taça em mil anos. Quer ver?",
    "Chat5": "A superfície é tão clara... eu poderia me acostumar.",
    "Chat6": "Quer disputar uma queda de braço? Não? Você que perde!",
    "Chat7": "O Antigo Inferno anda quieto. Quieto demais.",
    "Chat8": "Uma boa briga e uma boa bebida. Quem precisa de mais alguma coisa?",
    "Chat9": "Suika! Traga essa cabaça aqui!",
    "Chat10": "Kasen! Ainda esconde esses chifres sob dois coques?",
    "Chat11": "Satori, pare de ler minha mente e pergunte logo.",
    "Chat12": "Agora SIM, essa é a Kasen de que me lembro!",
    "Chat13": "Kanpai!",
    "Chat14": "Hahaha!"
  },
  "Chat_Komachi": {
    "Chat1": "Trabalho? Ah, os mortos não vão a lugar nenhum.",
    "Chat2": "O rio está largo hoje. Muitas almas não foram generosas em vida.",
    "Chat3": "Só uma sonequinha. A chefe não vai perceber...",
    "Chat4": "Distância é algo curioso. Posso alongá-la ou encurtá-la como quiser.",
    "Chat5": "Tem moedas aí? A passagem da barca não é barata, sabia?",
    "Chat6": "Shinigami não perseguem ninguém. Nós só... esperamos.",
    "Chat7": "Eremitas enganam a morte. Adivinhe quem precisa buscá-las?",
    "Chat8": "Ahh, um tempo perfeito para enrolar no trabalho.",
    "Chat9": "Ora, ora, uma eremita. Vou ficar de olho em você.",
    "Chat10": "Senhora Yuyuko! Quer que eu transporte alguém?",
    "Chat11": "Relaxe, jardineira. Nem tudo precisa ser cortado.",
    "Chat12": "Zzz...",
    "Chat13": "*bocejo*... Já acabou o expediente?"
  },
  "Chat_Seiga": {
    "Chat1": "Paredes são apenas sugestões, querida.",
    "Chat2": "Uma eremita que segue as regras? Que tédio terrível.",
    "Chat3": "Meu grampo abre caminho por qualquer coisa. Quer ver?",
    "Chat4": "A imortalidade é um passatempo. É preciso se divertir.",
    "Chat5": "Yoshika? Está por aí. Provavelmente presa numa porta.",
    "Chat6": "Que pessoa interessante você é. Talvez eu fique com você.",
    "Chat7": "Taoismo é simplesmente a arte de conseguir o que se quer.",
    "Chat8": "Kasen, querida! Ainda finge ser uma eremita respeitável?",
    "Chat9": "A sacerdotisa! Mande lembranças à sua caixa de doações.",
    "Chat10": "Só um buraquinho. Ninguém vai perceber.",
    "Chat11": "Ohohoho!"
  },
  "Chat_Aunn": {
    "Chat1": "Ninguém passa por mim! ...Ah, é só você.",
    "Chat2": "Protegi o santuário por eras antes de alguém notar minha presença!",
    "Chat3": "Aquilo é um youkai? Não? Certo, alarme falso.",
    "Chat4": "O trabalho de uma guardiã nunca acaba. Exceto nas sonecas.",
    "Chat5": "Pode fazer carinho na minha cabeça. Eu não me importo!",
    "Chat6": "O santuário anda animado. Isso é bom, né?",
    "Chat7": "Que cheiro bom... hoje é dia de oferendas?",
    "Chat8": "Eu fico de vigia. Você segue em frente!",
    "Chat9": "Reimu! Varri o caminho hoje... mais ou menos.",
    "Chat10": "Senhora Okina! Estou me esforçando muito para proteger, viu?",
    "Chat11": "Hehe~",
    "Chat12": "Au!",
    "Chat13": "Para trás! Esta pessoa está sob minha proteção!",
    "Chat14": "Uma cachorrinha empregada! Você protege uma mansão?",
    "Chat15": "Uma tengu loba! Você também guarda um portão?"
  },
  "Chat_Okina": {
    "Chat1": "Sou Okina Matara, a deusa oculta. Pode se curvar agora.",
    "Chat2": "Toda costa tem uma porta. A sua é até bem bonita.",
    "Chat3": "A Ursa Maior protege quem sabe para onde olhar.",
    "Chat4": "Segredos são o melhor tipo de poder. Principalmente os meus.",
    "Chat5": "Posso mandar você a qualquer lugar por uma porta dos fundos. Qualquer lugar.",
    "Chat6": "Ser uma sábia de Gensokyo é cansativo. Principalmente para os outros.",
    "Chat7": "Hum... você daria uma ótima dançarina de apoio.",
    "Chat8": "Estrelas, portas, estações... são meus brinquedos.",
    "Chat9": "Yukari. Ainda espia pelas fendas? Que falta de classe.",
    "Chat10": "Minha pequena guardiã! Você está indo muito bem.",
    "Chat11": "Por aqui. Cuidado com o degrau.",
    "Chat12": "Ahahaha!"
  },
  "Chat_Byakuren": {
    "Chat1": "Todos os seres são iguais, humanos e youkai.",
    "Chat2": "Namusan... O mundo está cheio de coisas que vale a pena proteger.",
    "Chat3": "Venha visitar o templo qualquer dia.",
    "Chat4": "Até uma monja pode aproveitar o sol sob sua sombrinha.",
    "Chat5": "A força do corpo e a força da mente caminham juntas.",
    "Chat6": "Fiquei selada por muito tempo. Cada dia desde então é precioso.",
    "Chat7": "Você tem se alimentado bem? Cuide de si.",
    "Chat8": "Capitã Murasa, obrigada por sempre nos reunir.",
    "Chat9": "Kogasa, quer dividir a sombra?",
    "Chat10": "Uma eremita que segue o caminho da disciplina... respeito isso, Kasen.",
    "Chat11": "Namusan...",
    "Chat12": "Que tempo agradável!",
    "Chat13": "Nazrin, Shou perdeu a pagoda de novo?",
    "Chat14": "Mamizou, obrigada por cuidar do templo.",
    "Chat15": "Jo'on, você anda roubando pessoas de novo?"
  },
  "Chat_Kosuzu": {
    "Chat1": "Bem-vindo a Suzunaan! Vai pegar emprestado ou só olhar?",
    "Chat2": "Posso ler qualquer livro só de tocá-lo. Até os que ninguém mais consegue.",
    "Chat3": "Livros demoníacos não são perigosos. Provavelmente. Em geral.",
    "Chat4": "Cuidado com essa página! É mais velha que a vila.",
    "Chat5": "Akyuu diz que leio livros demoníacos demais. É só inveja.",
    "Chat6": "Se eu desmaiar, não me coloque na seção de \"devoluções\".",
    "Chat7": "Um dia também vou jogar danmaku, você vai ver!",
    "Chat8": "Não se preocupe, trouxe uma lamparina. Ler no escuro faz mal aos olhos.",
    "Chat9": "Senhorita Reimu! Não tenho lido nada estranho. Juro!",
    "Chat10": "Senhorita Marisa, os livros que pegou emprestado estão muito atrasados.",
    "Chat11": "Senhorita Mamizou! Tem alguma história nova para mim?",
    "Chat12": "Você é aquela repórter... Não escreva sobre minha loja!",
    "Chat13": "Vamos ver... \"Sobre a Invocação de Youkai de Fumaça\"...",
    "Chat14": "Olá!",
    "Chat15": "Ehehe~"
  },
  "Chat_Mamizou": {
    "Chat1": "Não ligue para a cauda. Uma tanuki de respeito usa a sua com orgulho.",
    "Chat2": "Precisa de um empréstimo? Assine aqui e aqui. Não se preocupe com as letras miúdas.",
    "Chat3": "Enganar humanos é uma arte. Eu só faço isso com gentileza.",
    "Chat4": "Velha? Quem você chamou de velha? Estou no auge, fique sabendo.",
    "Chat5": "Sob a lua cheia, meus disfarces são perfeitos.",
    "Chat6": "Uma bebida, uma boa história e uma boa pegadinha. Uma bela noite.",
    "Chat7": "Sado é uma ilha de tanuki. Nenhuma raposa. Um lugar adorável.",
    "Chat8": "Sentiu um cheiro? Deve ser o incenso. Com certeza é o incenso.",
    "Chat9": "Kosuzu, menina. Mantenha esses livros quietos ou a sacerdotisa vai levá-los.",
    "Chat10": "Hmpf. Sinto cheiro de raposa.",
    "Chat11": "Kasen! Que tal uma revanche? Tenho treinado minha bebedeira.",
    "Chat12": "Kokoro, a cada dia você parece mais você mesma.",
    "Chat13": "Encontrou algo que valha um empréstimo, ratinha?",
    "Chat14": "Hum? Deixe-me olhar mais de perto...",
    "Chat15": "Fuu... nada como fumar em paz.",
    "Chat16": "Agora você me vê..."
  },
  "Chat_Nazrin": {
    "Chat1": "Perdeu alguma coisa? Eu encontro. Por uma taxa.",
    "Chat2": "Minha mestra perderia a cabeça se não estivesse presa ao corpo.",
    "Chat3": "O próprio Bishamonten me apoia, sabia? Demonstre respeito.",
    "Chat4": "Estas varinhas nunca mentem. Eu, por outro lado...",
    "Chat5": "Muenzuka está cheia de tesouros do mundo exterior. E sucata. Principalmente sucata.",
    "Chat6": "Estou trabalhando. É assim que trabalhar se parece.",
    "Chat7": "Tem queijo? É para meus ratos. E para mim.",
    "Chat8": "Chiado? ...Não fui eu. Foi um dos meus ratos.",
    "Chat9": "Senhora Hijiri. Minha mestra diz que não perdeu nada esta semana. Minha mestra está mentindo.",
    "Chat10": "Capitã, se sua âncora sumir de novo, minhas tarifas aumentaram.",
    "Chat11": "Perdida de novo, sombrinha? Posso encontrar alguém para você assustar.",
    "Chat12": "Nem pense em penhorar minhas varinhas, tanuki.",
    "Chat13": "A ladra da vassoura! Tire as mãos do meu tesouro.",
    "Chat14": "Minhas varinhas estão tremendo... há um tesouro por perto!",
    "Chat15": "Hum... por aqui.",
    "Chat16": "Balance, pequeno cristal. Mostre-me.",
    "Chat17": "Heh. Fácil demais."
  },
  "Chat_Suwako": {
    "Chat1": "Kero kero~ Quer ver um truque de sapo?",
    "Chat2": "Não se deixe enganar pelo rosto. Sou deusa há mais de dois mil anos.",
    "Chat3": "Montanhas, rios, terra firme... me dê um minuto e movo um deles para você.",
    "Chat4": "Não sou uma deusa dos sapos. Só gosto muito, muito de sapos.",
    "Chat5": "O santuário Moriya? Kanako administra. Eu sou a dona.",
    "Chat6": "Perdi uma guerra uma vez. Foi a melhor coisa que aconteceu à minha fé.",
    "Chat7": "Um jogo? Claro! Quem perder paga o saquê.",
    "Chat8": "Olhos no meu chapéu? Que olhos no meu chapéu?",
    "Chat9": "Kanako, você não deveria estar reunindo fiéis? Estou cochilando.",
    "Chat10": "Sanae! Lembrou de alimentar os sapos?",
    "Chat11": "Você aí, fada do gelo. Descongele meus sapos.",
    "Chat12": "Reimu, seu santuário precisa de mais sapos. E mais visitantes.",
    "Chat13": "Pula, pula, pula!",
    "Chat14": "Cuidado com o anel de ferro! É mais afiado do que parece.",
    "Chat15": "Ahaha! Você precisava ver sua cara."
  },
  "Chat_Kanako": {
    "Chat1": "Fé é como qualquer negócio. Você precisa de um bom produto e uma oferta melhor.",
    "Chat2": "Já visitou o santuário Moriya? Agora o teleférico funciona todo dia.",
    "Chat3": "Uma deusa deve acompanhar os tempos. Até com fusão nuclear, se atrair fiéis.",
    "Chat4": "Um presente? Para mim? ...Bem, talvez eu possa lhe dar uma bênção.",
    "Chat5": "Não ligue para o aro de corda. É um lembrete de quem venceu.",
    "Chat6": "Vento e chuva obedecem a mim. Avise se sua plantação precisar.",
    "Chat7": "Tradição é boa. Progresso é melhor.",
    "Chat8": "Hmpf. Demonstre um pouco de reverência, sim?",
    "Chat9": "Suwako, o santuário não vai se administrar sozinho.",
    "Chat10": "Sanae, quantos novos fiéis esta semana?",
    "Chat11": "Utsuho, como está o reator? Espero que nada esteja derretendo.",
    "Chat12": "Kappa, sobre a manutenção do teleférico...",
    "Chat13": "Reimu, posso lhe emprestar alguns fiéis. Por uma pequena taxa.",
    "Chat14": "Contemple! O santuário Moriya lhe dá as boas-vindas.",
    "Chat15": "Onbashira! Cuidado com os dedos dos pés.",
    "Chat16": "Hahaha! Esplêndido."
  },
  "Chat_InuSakuya": {
    "Chat1": "...Au.",
    "Chat2": "O chá está pronto. Posso ganhar um petisco agora?",
    "Chat3": "Sou a empregada-chefe. Também sou uma cachorra. As duas coisas são verdade.",
    "Chat4": "...Aquilo é um graveto? Não. Sou uma profissional.",
    "Chat5": "Posso parar o tempo se precisar. É só dizer \"senta\".",
    "Chat6": "Minha cauda faz isso sozinha. Ignore, por favor.",
    "Chat7": "Ojou-sama diz que sou uma boa menina. Eu concordo.",
    "Chat8": "...Fumo.",
    "Chat9": "Ojou-sama. ...Passeio?",
    "Chat10": "...Quem é aquela? Ela parece muito familiar.",
    "Chat11": "Guardiã do portão. Você estava dormindo de novo. Vou contar.",
    "Chat12": "Jovem senhorita. Não puxe minhas orelhas, por favor.",

  "Buffs": {
    "KasenBuff": {
      "DisplayName": "Kasen Ibaraki",
      "Description": "Uma eremita rigorosa fica de olho em você... e nos seus lanches."
    },
    "YuugiBuff": {
      "DisplayName": "Yuugi Hoshiguma",
      "Description": "A oni mais forte do Antigo Inferno quer companhia para beber."
    },
    "KomachiBuff": {
      "DisplayName": "Komachi Onozuka",
      "Description": "Uma barqueira do rio Sanzu está \"trabalhando\" ao seu lado."
    },
    "SeigaBuff": {
      "DisplayName": "Seiga Kaku",
      "Description": "Uma eremita maligna se interessou por você. Isso não pode ser bom."
    },
    "AunnBuff": {
      "DisplayName": "Aunn Komano",
      "Description": "Uma guardiã de santuário ilumina seu caminho e late para quem quiser lhe fazer mal."
    },
    "OkinaBuff": {
      "DisplayName": "Okina Matara",
      "Description": "A deusa oculta compartilha um pouco da luz das estrelas da Ursa Maior."
    },
    "ByakurenBuff": {
      "DisplayName": "Byakuren Hijiri",
      "Description": "A líder do templo Myouren caminha ao seu lado sob sua sombrinha."
    },
    "KosuzuBuff": {
      "DisplayName": "Kosuzu Motoori",
      "Description": "A leitora de Suzunaan lê ao seu lado à luz de uma lamparina."
    },
    "MamizouBuff": {
      "DisplayName": "Mamizou Futatsuiwa",
      "Description": "Uma bake-danuki está seguindo você. Fique de olho na sua carteira."
    },
    "NazrinBuff": {
      "DisplayName": "Nazrin",
      "Description": "Uma ratinha radiestesista ilumina seu caminho e procura tesouros."
    },
    "SuwakoBuff": {
      "DisplayName": "Suwako Moriya",

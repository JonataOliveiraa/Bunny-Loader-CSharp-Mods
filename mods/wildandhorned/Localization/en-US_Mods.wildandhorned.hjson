{
  "Items": {
    "IbarakiBox": {
      "DisplayName": "Ibaraki Box of a Hundred Medicines",
      "Tooltip": "Summons Kasen Ibaraki\nA hermit's wooden box that turns sake into medicine"
    },
    "StarBearSakeDish": {
      "DisplayName": "Star-Bear Sake Dish",
      "Tooltip": "Summons Yuugi Hoshiguma\nNot a drop has ever been spilled from it, not even mid-brawl"
    },
    "SanzuFerryCoin": {
      "DisplayName": "Sanzu Ferry Coin",
      "Tooltip": "Summons Komachi Onozuka\nThe fare for crossing the river. The ferrywoman is in no hurry"
    },
    "WallPassingHairpin": {
      "DisplayName": "Wall-Passing Hairpin",
      "Tooltip": "Summons Seiga Kaku\nOpens a way through any wall. Please knock first"
    },
    "GuardianShrineBell": {
      "DisplayName": "Guardian's Shrine Bell",
      "Tooltip": "Summons Aunn Komano to light your way\nRing it, and the shrine's guardian comes running"
    },
    "SecretBackDoor": {
      "DisplayName": "Secret God's Back Door",
      "Tooltip": "Summons Okina Matara to light your way\nSeven stars mark a door that opens onto somewhere else entirely"
    },
    "SorcerersSutraScroll": {
      "DisplayName": "Sorcerer's Sutra Scroll",
      "Tooltip": "Summons Byakuren Hijiri\nA magic scroll whose text glows as it unrolls"
    },
    "SuzunaanDemonBook": {
      "DisplayName": "Suzunaan Demon Book",
      "Tooltip": "Summons Kosuzu Motoori to light your way\nBorrowed from Suzunaan. Please return it on time"
    },
    "TanukiLeaf": {
      "DisplayName": "Tanuki Leaf",
      "Tooltip": "Summons Mamizou Futatsuiwa\nPut it on your head and you could be anyone. Or anything"
    },
    "NazrinPendulum": {
      "DisplayName": "Nazrin Pendulum",
      "Tooltip": "Summons Nazrin to light your way\nIts crystal swings toward whatever you're looking for"
    },
    "MoriyaIronRing": {
      "DisplayName": "Moriya Iron Ring",
      "Tooltip": "Summons Suwako Moriya to light your way\nSharper than it looks. Mind your fingers"
    },
    "MiniatureOnbashira": {
      "DisplayName": "Miniature Onbashira",
      "Tooltip": "Summons Kanako Yasaka\nA small sacred pillar. Please don't throw it off a cliff"
    },
    "MaidsBellCollar": {
      "DisplayName": "Maid's Bell Collar",
      "Tooltip": "Summons Inu Sakuya to light your way\nIt jingles when she wags"
    },
    "OverdueNotice": {
      "DisplayName": "Overdue Notice",
      "Tooltip": "Summons Shion Yorigami\nFinal notice. Again"
    },
    "DesignerHandbag": {
      "DisplayName": "Designer Handbag",
      "Tooltip": "Summons Jo'on Yorigami to light your way\nOne of a kind. She owns twelve"
    },
    "DaiShogiPiece": {
      "DisplayName": "Dai Shogi Piece",
      "Tooltip": "Summons Momiji Inubashiri\nFrom a set with more pieces than you'd believe"
    }
  },
  "Buffs": {
    "KasenBuff": {
      "DisplayName": "Kasen Ibaraki",
      "Description": "A strict hermit keeps an eye on you... and on your snacks."
    },
    "YuugiBuff": {
      "DisplayName": "Yuugi Hoshiguma",
      "Description": "The strongest oni of the Former Hell wants a drinking buddy."
    },
    "KomachiBuff": {
      "DisplayName": "Komachi Onozuka",
      "Description": "A ferrywoman of the Sanzu River is \"working\" beside you."
    },
    "SeigaBuff": {
      "DisplayName": "Seiga Kaku",
      "Description": "A wicked hermit has taken an interest in you. That can't be good."
    },
    "AunnBuff": {
      "DisplayName": "Aunn Komano",
      "Description": "A shrine guardian lights your way, and barks at anything that means you harm."
    },
    "OkinaBuff": {
      "DisplayName": "Okina Matara",
      "Description": "The hidden god shares a little of her Big Dipper's starlight."
    },
    "ByakurenBuff": {
      "DisplayName": "Byakuren Hijiri",
      "Description": "The head of Myouren Temple walks beside you under her parasol."
    },
    "KosuzuBuff": {
      "DisplayName": "Kosuzu Motoori",
      "Description": "The bookworm of Suzunaan reads by lamplight beside you."
    },
    "MamizouBuff": {
      "DisplayName": "Mamizou Futatsuiwa",
      "Description": "A bake-danuki is following you. Keep an eye on your wallet."
    },
    "NazrinBuff": {
      "DisplayName": "Nazrin",
      "Description": "A dowsing mouse lights your way, and keeps an eye out for treasure."
    },
    "SuwakoBuff": {
      "DisplayName": "Suwako Moriya",
      "Description": "The native goddess of the Moriya Shrine hops along beside you."
    },
    "KanakoBuff": {
      "DisplayName": "Kanako Yasaka",
      "Description": "The goddess of the Moriya Shrine has taken an interest in your faith."
    },
    "InuSakuyaBuff": {
      "DisplayName": "Inu Sakuya",
      "Description": "A very good maid. A very good dog."
    },
    "ShionBuff": {
      "DisplayName": "Shion Yorigami",
      "Description": "The goddess of poverty is following you. Hide your snacks."
    },
    "JoonBuff": {
      "DisplayName": "Jo'on Yorigami",
      "Description": "A goddess of pestilence lights your way. Your wallet feels lighter already."
    },
    "MomijiBuff": {
      "DisplayName": "Momiji Inubashiri",
      "Description": "A white wolf tengu is keeping watch over you."
    }
  },
